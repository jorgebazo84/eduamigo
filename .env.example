# Clave de la API de Claude (Anthropic) para el tutor "Pregúntame".
# Se usa SOLO en el servidor; nunca llega al navegador. Consíguela en console.anthropic.com.
ANTHROPIC_API_KEY=
# Modelo del tutor (opcional). Por defecto el más económico:
# TUTOR_MODEL=claude-haiku-5-5
# Modelo para leer fotos y generar/corregir fichas (opcional). Si lee mal la letra, prueba claude-sonnet-5-5:
# VISION_MODEL=claude-haiku-5-5
# Para pruebas sin gastar saldo (respuestas simuladas):
# TUTOR_PROVIDER=mock

# Fotos de deberes y fichas (se guardan 365 días; después se borra el original y queda la miniatura).
# En producción usa un almacenamiento de objetos compatible con S3 (p. ej. Cloudflare R2, 10 GB gratis al mes).
# Si se deja vacío, se guardan en disco local (PHOTO_DIR); en Render ese disco se borra en cada despliegue.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# PHOTO_DIR=./data/photos
# PHOTO_RETENTION_DAYS=365

# Búsqueda de índices de libros por ISBN (opcional): clave gratuita de Google Books y modelo con búsqueda web.
# La búsqueda web hay que activarla en la consola de Anthropic.
# GOOGLE_BOOKS_API_KEY=
# SEARCH_MODEL=claude-haiku-5-5

# Página privada de avisos de errores de la IA: /admin/avisos?token=ADMIN_TOKEN (clave larga, solo tuya)
ADMIN_TOKEN=

# Base de datos: Turso (SQLite en la nube). Crea la base de datos en una región europea (p. ej. Frankfurt).
# Si se dejan vacías, se usa el archivo local eduamigo.db (en Render se perdería en cada despliegue).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Copia de seguridad diaria de la base de datos en el almacenamiento de fotos (R2). Días que se guardan:
# BACKUP_RETENTION_DAYS=30
